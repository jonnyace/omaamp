#!/usr/bin/env python3
"""JSON bridge between the Omarchy shell plugin and the conversion engine.

The shell is a single long-running Quickshell process, so the plugin does no
work in-process beyond drawing: every command here is a short-lived subprocess
that prints one JSON object on stdout and exits. Errors are reported as
``{"error": ...}`` with a zero exit status, so QML has one shape to parse
rather than a split between stdout and exit codes.

    skinner search <query> [--limit N] [--offset N]
    skinner browse [--limit N] [--offset N]
    skinner preview <md5>            convert without installing
    skinner install <md5>            convert, write theme, return its name
    skinner use <md5-or-link>        wear a skin from its id or museum link
    skinner size <large|original>    set the player window scale
    skinner apply <name>             switch cliamp to an installed theme
    skinner themes                   installed themes, ours flagged
    skinner save <name> <json>       write an edited palette
    skinner remove <name>
    skinner sync                     derive a theme from the current Omarchy theme
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import io
import tempfile
import subprocess
import sys
import time
import zipfile
import urllib.error
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from cliamp_skinner import build, load, museum  # noqa: E402
from cliamp_skinner.color import parse_hex, to_hex  # noqa: E402
from cliamp_skinner.theme import SLOTS, Theme  # noqa: E402

THEMES = Path.home() / ".config" / "cliamp" / "themes"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omaamp"
SHOTS = CACHE / "screenshots"
SKINS = CACHE / "skins"
SPRITES = CACHE / "sprites"
# Written next to each generated theme so "Mine" can tell our themes from
# cliamp's built-ins and from anything the user hand-wrote.
INDEX = CACHE / "installed.json"

# The one piece of state shared between the bar plugin and the player app,
# which are separate processes. The plugin writes it; the app watches it and
# hot-swaps its skin, so choosing a skin never has to restart the player.
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omaamp"
CURRENT = STATE / "current.json"


def atomic_write_text(path: Path, text: str) -> None:
    """Replace a watched state file only after its complete contents exist."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def atomic_write_json(path: Path, payload: object) -> None:
    atomic_write_text(path, json.dumps(payload, indent=1))


def current_player_size() -> str:
    """Keep the size choice when another command replaces player state."""
    try:
        value = json.loads(CURRENT.read_text()).get("size")
    except (OSError, ValueError):
        value = None
    return value if value in ("large", "original") else "large"


def emit(payload: dict) -> int:
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 0


def slugify(name: str) -> str:
    stem = re.sub(r"\.(wsz|zip|wal)$", "", name, flags=re.I)
    return re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-") or "skin"


def read_index() -> dict:
    try:
        return json.loads(INDEX.read_text())
    except (OSError, ValueError):
        return {}


def write_index(data: dict) -> None:
    atomic_write_json(INDEX, data)


def _require_md5(value: str) -> str:
    """API identifiers become cache paths; only literal md5 hex may pass."""
    if not museum.valid_md5(value):
        raise ValueError(f"invalid skin identifier: {value!r}")
    return value.lower()


# Decompression caps for skin archives: any single sheet or text file over
# this is not a skin asset, it is a bomb.
MAX_MEMBER_BYTES = 16 * 1024 * 1024
MAX_ARCHIVE_BYTES = 64 * 1024 * 1024
SPRITE_SCHEMA = 2
SUPPORTED_COMPRESSION = {zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED}


def _safe_read(zf: "zipfile.ZipFile", entry: "zipfile.ZipInfo") -> bytes:
    info = entry
    if info.flag_bits & 1:
        raise ValueError(f"encrypted archive member: {info.filename}")
    if info.compress_type not in SUPPORTED_COMPRESSION:
        raise ValueError(f"unsupported compression for archive member: {info.filename}")
    if info.file_size > MAX_MEMBER_BYTES:
        raise ValueError(f"archive member too large: {info.filename} ({info.file_size} bytes)")
    return zf.read(entry)


def cache_screenshot(ref: museum.SkinRef) -> str:
    """Download a skin's screenshot once and return its local path.

    These are the museum's own 275x348 renders of the Winamp window, which is
    what makes the picker recognizable -- a row of hex swatches would not be.
    """
    if not ref.screenshot_url or not museum.valid_md5(ref.md5):
        return ""
    SHOTS.mkdir(parents=True, exist_ok=True)
    path = SHOTS / f"{ref.md5}.png"
    if not path.exists():
        try:
            path.write_bytes(museum._request(ref.screenshot_url, limit=8 * 1024 * 1024))
        except (urllib.error.URLError, OSError):
            return ""
    return str(path)


def fetch_skin(md5: str) -> bytes:
    md5 = _require_md5(md5)
    SKINS.mkdir(parents=True, exist_ok=True)
    path = SKINS / f"{md5}.wsz"
    if path.exists():
        return path.read_bytes()
    data = museum.query(
        "query($m:String!){fetch_skin_by_md5(md5:$m){"
        "... on ClassicSkin{filename download_url}}}",
        {"m": md5},
    )["fetch_skin_by_md5"]
    if not data:
        raise LookupError(f"no skin with md5 {md5}")
    blob = museum.download(data["download_url"])
    path.write_bytes(blob)
    (SKINS / f"{md5}.name").write_text(data.get("filename") or md5)
    return blob


def skin_name(md5: str) -> str:
    try:
        return (SKINS / f"{md5}.name").read_text().strip()
    except OSError:
        return md5


def theme_payload(built: Theme, **extra) -> dict:
    # Named `built`, not `theme`: callers pass a `theme=<slug>` field through
    # **extra, which would collide with the positional name.
    return {
        "colors": {slot: to_hex(getattr(built, slot)) for slot in SLOTS},
        "invented": sorted(set(built.invented)),
        "adjusted": sorted(set(built.adjusted)),
        "notes": built.notes,
        **extra,
    }


def listing(refs: list[museum.SkinRef]) -> dict:
    return {
        "skins": [
            {
                "md5": r.md5,
                "name": re.sub(r"\.(wsz|zip)$", "", r.filename, flags=re.I) or r.md5,
                "screenshot": cache_screenshot(r),
                "url": r.museum_url,
            }
            for r in refs
        ]
    }


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------


def cmd_search(args) -> int:
    return emit(listing(museum.search(args.query, first=args.limit, offset=args.offset)))


FEATURED = CACHE / "featured.json"


def cmd_fetch_featured(args) -> int:
    """Cache the museum's top-N skins locally: list, screenshots, archives.

    sort:MUSEUM is the museum's own curated ranking, so "top" here means the
    order a visitor sees on skins.webamp.org -- classics first, not upload
    order. Everything lands in the cache, which makes the panel's default
    Browse view instant and fully offline afterwards.
    """
    import concurrent.futures as futures

    want = args.count
    refs, offset = [], 0
    while len(refs) < want:
        page = museum.browse(first=min(80, want - len(refs) + 20), offset=offset)
        if not page:
            break
        offset += len(page)
        seen = {r.md5 for r in refs}
        refs.extend(r for r in page if r.md5 not in seen)
    refs = refs[:want]

    def prime(ref):
        try:
            cache_screenshot(ref)
            fetch_skin(ref.md5)
            return None
        except Exception as exc:
            return f"{ref.md5[:8]} {ref.filename}: {exc}"

    with futures.ThreadPoolExecutor(8) as pool:
        errors = [e for e in pool.map(prime, refs) if e]

    atomic_write_json(FEATURED, [
        {
            "md5": r.md5,
            "name": re.sub(r"\.(wsz|zip)$", "", r.filename, flags=re.I) or r.md5,
            "screenshot": str(SHOTS / f"{r.md5}.png"),
            "url": r.museum_url,
        }
        for r in refs
    ])
    return emit({"featured": len(refs), "errors": errors[:10]})


def cmd_featured(args) -> int:
    """Serve the cached top list; fall back to a live browse when absent."""
    try:
        rows = json.loads(FEATURED.read_text())
        rows = [r for r in rows if Path(r.get("screenshot", "")).exists()]
        if rows:
            return emit({"skins": rows[args.offset:args.offset + args.limit]})
    except (OSError, ValueError):
        pass
    return cmd_browse(args)


def cmd_browse(args) -> int:
    return emit(listing(museum.browse(first=args.limit, offset=args.offset)))


# Sheets OmaAmp draws the main window from. numbers/nums_ex are alternatives:
# 15.7% of the corpus ships only the extended variant.
SHEETS = (
    "main.bmp", "titlebar.bmp", "cbuttons.bmp", "text.bmp", "posbar.bmp",
    "volume.bmp", "balance.bmp", "shufrep.bmp", "monoster.bmp", "playpaus.bmp",
    "numbers.bmp", "nums_ex.bmp", "pledit.bmp",
    # Not a sheet: the analyzer's 24-colour ramp, read by the player at runtime.
    "viscolor.txt", "pledit.txt",
)


def _member_name(filename: str) -> str:
    """Classic skins came from Windows; both ZIP path separators occur."""
    return filename.replace("\\", "/").rsplit("/", 1)[-1].lower()


def _skin_members(zf: "zipfile.ZipFile") -> dict[str, "zipfile.ZipInfo"]:
    """Wanted members by basename, with the last duplicate winning.

    Extracting a skin on Winamp's case-insensitive filesystem had that result;
    keeping the last copy also prevents an early junk member from shadowing the
    real sheet later in the archive.
    """
    members = {}
    for entry in zf.infolist():
        if entry.is_dir() or entry.filename.endswith(("/", "\\")):
            continue
        name = _member_name(entry.filename)
        if name in SHEETS:
            members[name] = entry
    return members


def _manifest_valid(out: Path, digest: str) -> bool:
    try:
        manifest = json.loads((out / "manifest.json").read_text())
    except (OSError, ValueError):
        return False
    if manifest.get("schema") != SPRITE_SCHEMA or manifest.get("archive") != digest:
        return False
    files = manifest.get("files", {})
    if "main.bmp" not in files:
        return False
    for name, expected in files.items():
        path = out / name
        try:
            data = path.read_bytes()
        except OSError:
            return False
        if (
            len(data) != expected.get("bytes")
            or hashlib.sha256(data).hexdigest() != expected.get("sha256")
        ):
            return False
    return True


def extract_archive(data: bytes, md5: str, *, force: bool = False) -> Path:
    """Normalize one archive into an immutable, content-addressed directory."""
    digest = hashlib.sha256(data).hexdigest()
    out = SPRITES / f"{md5}-v{SPRITE_SCHEMA}-{digest[:12]}"
    if not force and _manifest_valid(out, digest):
        return out

    with zipfile.ZipFile(io.BytesIO(data)) as zf:
        members = _skin_members(zf)
        if "main.bmp" not in members:
            raise ValueError("skin has no main.bmp")
        total = sum(entry.file_size for entry in members.values())
        if total > MAX_ARCHIVE_BYTES:
            raise ValueError("archive exceeds decompression budget")
        for entry in members.values():
            if entry.file_size > MAX_MEMBER_BYTES:
                raise ValueError(f"archive member too large: {entry.filename} ({entry.file_size} bytes)")
            if entry.flag_bits & 1:
                raise ValueError(f"encrypted archive member: {entry.filename}")
            if entry.compress_type not in SUPPORTED_COMPRESSION:
                raise ValueError(f"unsupported compression for archive member: {entry.filename}")

        SPRITES.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=f".{md5}.", dir=SPRITES) as temporary:
            staging = Path(temporary)
            files = {}
            for sheet in SHEETS:
                entry = members.get(sheet)
                if entry is None:
                    continue
                payload = _safe_read(zf, entry)
                (staging / sheet).write_bytes(payload)
                files[sheet] = {
                    "bytes": len(payload),
                    "sha256": hashlib.sha256(payload).hexdigest(),
                }

            # Winamp used the middle of volume.bmp when balance.bmp was absent.
            # Keeping the substitute as a real normalized file lets QML stay a
            # simple sprite renderer instead of learning skin compatibility.
            if "balance.bmp" not in files and "volume.bmp" in files:
                payload = (staging / "volume.bmp").read_bytes()
                (staging / "balance.bmp").write_bytes(payload)
                files["balance.bmp"] = {
                    "bytes": len(payload),
                    "sha256": hashlib.sha256(payload).hexdigest(),
                    "substitute": "volume.bmp",
                }

            atomic_write_json(staging / "manifest.json", {
                "schema": SPRITE_SCHEMA,
                "archive": digest,
                "md5": md5,
                "files": files,
            })
            if out.exists() and not force and _manifest_valid(out, digest):
                return out
            if out.exists():
                # A damaged directory gets a fresh immutable name; a running
                # player may still be reading the old one.
                out = SPRITES / f"{out.name}-refresh-{time.time_ns()}"
            os.rename(staging, out)
    return out


def extract_skin(md5: str, *, force: bool = False) -> Path:
    return extract_archive(fetch_skin(md5), md5, force=force)


def cmd_extract(args) -> int:
    """Unpack a skin into a flat, checked and versioned sprite directory."""
    out = extract_skin(args.md5, force=args.force)
    return emit(_sprite_payload(args.md5, out))


def _sprite_payload(md5: str, out: Path) -> dict:
    present = sorted(p.name for p in out.glob("*.bmp"))
    return {
        "dir": str(out),
        "md5": md5,
        "name": skin_name(md5),
        "sheets": present,
        # The window needs to know which digit sheet it got: nums_ex leads with
        # a minus sign, shifting every glyph one cell to the right.
        "extendedDigits": "numbers.bmp" not in present and "nums_ex.bmp" in present,
        "missing": [s for s in ("main.bmp", "cbuttons.bmp", "titlebar.bmp", "text.bmp") if s not in present],
    }


def cmd_preview(args) -> int:
    # Fetch first: the cached display name is written as a side effect of the
    # download, so reading it beforehand yields the md5 on a cold cache.
    data = fetch_skin(args.md5)
    name = skin_name(args.md5)
    theme = build(load(data, name=name))
    return emit(theme_payload(theme, md5=args.md5, name=name))


def cmd_install(args) -> int:
    data = fetch_skin(args.md5)
    filename = skin_name(args.md5)
    theme = build(load(data, name=filename))
    slug = slugify(filename)
    THEMES.mkdir(parents=True, exist_ok=True)
    (THEMES / f"{slug}.toml").write_text(theme.to_toml())

    index = read_index()
    index[slug] = {"md5": args.md5, "source": filename}
    write_index(index)
    return emit(theme_payload(theme, theme=slug, md5=args.md5, name=filename))


def cmd_use(args) -> int:
    """Wear a skin: unpack it, theme cliamp to match, and tell the player.

    One command because they are one user action. The player is a separate
    process, so the handoff is a state file it watches rather than an IPC call
    into an instance that may not be running yet.
    """
    # Validate before this user-provided value is ever used as a cache path.
    # This also turns links copied from skins.webamp.org into their skin id.
    args.md5 = museum.skin_md5(args.md5)

    # Normalization owns archive compatibility, cache invalidation and safety;
    # every caller uses this one path.
    out = extract_skin(args.md5)
    sprites = _sprite_payload(args.md5, out)

    data = fetch_skin(args.md5)
    filename = skin_name(args.md5)
    built = build(load(data, name=filename))
    slug = slugify(filename)
    THEMES.mkdir(parents=True, exist_ok=True)
    (THEMES / f"{slug}.toml").write_text(built.to_toml())

    index = read_index()
    index[slug] = {"md5": args.md5, "source": filename}
    write_index(index)

    atomic_write_json(CURRENT, {
        "md5": args.md5,
        "dir": sprites["dir"],
        "name": re.sub(r"\.(wsz|zip)$", "", filename, flags=re.I),
        "extendedDigits": sprites["extendedDigits"],
        "theme": slug,
        "size": current_player_size(),
    })

    if not args.no_theme:
        subprocess.run(["cliamp", "theme", slug], capture_output=True, text=True, timeout=15)

    return emit(theme_payload(built, theme=slug, md5=args.md5, name=filename,
                              dir=sprites["dir"], missing=sprites["missing"]))


def cmd_make_theme(args) -> int:
    """Turn a skin into a full Omarchy theme under ~/.config/omarchy/themes/.

    This is the deep end of "wear a skin": colors.toml plus a rendered
    wallpaper, which Omarchy's own template engine then fans out to every
    themed app. Apply with `omarchy theme set <slug>`.
    """
    from cliamp_skinner import omarchy_theme

    data = fetch_skin(args.md5)
    filename = skin_name(args.md5)
    skin = load(data, name=filename)
    built = build(skin)
    slug = "omaamp-" + slugify(filename)

    main_bmp = None
    with zipfile.ZipFile(io.BytesIO(data)) as zf:
        members = {}
        for entry in zf.namelist():
            if not entry.endswith("/"):
                members.setdefault(entry.rsplit("/", 1)[-1].lower(), entry)
        if "main.bmp" in members:
            main_bmp = zf.read(members["main.bmp"])

    dest = Path.home() / ".config" / "omarchy" / "themes" / slug
    # Physical resolution, so the wallpaper maps 1:1 to hardware pixels; any
    # backend resampling of pixel art shows immediately on a HiDPI panel.
    width, height = 2560, 1600
    try:
        mon = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                        capture_output=True, text=True, timeout=5).stdout)[0]
        width, height = int(mon["width"]), int(mon["height"])
    except Exception:
        pass
    colors = omarchy_theme.build_theme_dir(dest, skin, built, main_bmp, filename,
                                           width=width, height=height)
    return emit({
        "theme": slug,
        "dir": str(dest),
        "colors": colors,
        "apply": f"omarchy theme set {slug}",
    })


# The 11 radio streams cliamp ships as its default queue. The daemon cannot
# enumerate its own queue over IPC, so the playlist window lists these (and
# the user's TOML playlists) instead -- same content, addressable.
STREAMS = [
    ("Lofi Stream", "lofi"), ("Synthwave Stream", "synthwave"),
    ("EDM Stream", "edm"), ("NCS Stream", "ncs"),
    ("NCS House Stream", "ncs-house"), ("NCS Dubstep Stream", "ncs-dubstep"),
    ("NCS Drum & Bass Stream", "ncs-dnb"), ("NCS Trap Stream", "ncs-trap"),
    ("NCS Phonk Stream", "ncs-phonk"), ("NCS Pop Stream", "ncs-pop"),
    ("NCS Chill Stream", "ncs-chill"),
]
PLAYLISTS_DIR = Path.home() / ".config" / "cliamp" / "playlists"
NOW_PLAYLIST = "omaamp-now"


def _sock(payload: dict) -> dict:
    import socket as _socket
    path = Path.home() / ".config" / "cliamp" / "cliamp.sock"
    s = _socket.socket(_socket.AF_UNIX)
    s.settimeout(5)
    try:
        s.connect(str(path))
        s.sendall((json.dumps(payload) + "\n").encode())
        return json.loads(s.recv(1 << 16).decode(errors="replace"))
    finally:
        s.close()


def _read_playlists() -> list[dict]:
    import tomllib
    out = []
    if not PLAYLISTS_DIR.is_dir():
        return out
    for f in sorted(PLAYLISTS_DIR.glob("*.toml")):
        name = f.stem
        if name == NOW_PLAYLIST:
            continue  # our own scratch playlist, not user content
        try:
            doc = tomllib.loads(f.read_text())
        except Exception:
            continue
        tracks = [
            {"title": t.get("title") or Path(str(t.get("path", ""))).name, "path": t.get("path", "")}
            for t in doc.get("track", [])
            if t.get("path")
        ]
        if tracks:
            out.append({"name": name, "tracks": tracks})
    return out


def cmd_pl(args) -> int:
    """Everything the playlist window shows, in one call."""
    now = {}
    try:
        now = _sock({"cmd": "status"})
    except Exception:
        pass
    return emit({
        "now": {
            "state": now.get("state", "stopped"),
            "title": (now.get("track") or {}).get("title", ""),
            "path": (now.get("track") or {}).get("path", ""),
            "playlist": now.get("playlist", ""),
        },
        "streams": [
            {"title": t, "path": f"http://radio.cliamp.stream/{slug}/stream"}
            for t, slug in STREAMS
        ],
        "playlists": _read_playlists(),
    })


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _load_now(tracks: list[tuple[str, str]]) -> dict:
    """Write the scratch playlist and make cliamp play it, starting now.

    This is the only "play THIS, immediately" mechanism the daemon offers:
    `queue` only appends, and `play` ignores a path argument. Loading a
    playlist replaces the queue and starts playback at its first track, so
    the scratch file is written with the chosen track first.
    """
    PLAYLISTS_DIR.mkdir(parents=True, exist_ok=True)
    body = "".join(
        f'[[track]]\ntitle = "{_toml_escape(t)}"\npath = "{_toml_escape(p)}"\n\n'
        for t, p in tracks
    )
    (PLAYLISTS_DIR / f"{NOW_PLAYLIST}.toml").write_text(body)
    return _sock({"cmd": "load", "playlist": NOW_PLAYLIST})


def cmd_play_now(args) -> int:
    title = args.title or (Path(args.path).name if not args.path.startswith("http") else args.path)
    result = _load_now([(title, args.path)])
    if not result.get("ok"):
        return emit({"error": result.get("error", "cliamp rejected the load")})
    return emit({"playing": title})


def cmd_play_track(args) -> int:
    """Play track N of a playlist by loading it rotated to start there.

    Rotation keeps every track reachable with next/prev and keeps their
    relative order, which is as close to Winamp's "start at the highlighted
    track" as the IPC surface allows.
    """
    for pl in _read_playlists():
        if pl["name"] != args.playlist:
            continue
        tracks = [(t["title"], t["path"]) for t in pl["tracks"]]
        if not (0 <= args.index < len(tracks)):
            return emit({"error": f"track {args.index} out of range"})
        rotated = tracks[args.index:] + tracks[:args.index]
        result = _load_now(rotated)
        if not result.get("ok"):
            return emit({"error": result.get("error", "cliamp rejected the load")})
        return emit({"playing": rotated[0][0], "playlist": args.playlist})
    return emit({"error": f"no playlist named {args.playlist}"})


BUILTIN_THEMES_URL = (
    "https://raw.githubusercontent.com/bjarneo/cliamp/main/theme/themes/{}.toml"
)


def builtin_theme_colors(slug: str) -> dict:
    """Fetch a built-in cliamp theme's colors, cached after first use.

    The binary embeds its themes without names attached, so the source repo
    is the only reliable place to read a built-in's palette from.
    """
    cache = CACHE / "builtin-themes"
    cache.mkdir(parents=True, exist_ok=True)
    path = cache / f"{slug}.toml"
    if not path.exists():
        try:
            path.write_bytes(museum._request(BUILTIN_THEMES_URL.format(slug)))
        except Exception:
            return {}
    return read_theme(path)


def cmd_use_theme(args) -> int:
    """Dress the player in a cliamp theme, as the flat TUI face.

    The TUI face is vector-drawn from the same seven colors cliamp reads,
    which is what makes the theme list and the Tune tab live controls for
    the player rather than cliamp-only settings.
    """
    slug = slugify(args.name)
    colors = read_theme(THEMES / f"{slug}.toml") if (THEMES / f"{slug}.toml").exists() else {}
    if not colors:
        colors = builtin_theme_colors(slug)
    missing = [k for k in SLOTS if k not in colors]
    if missing and "bg" in missing and len(missing) == 1:
        # cliamp documents bg as optional; the face still needs one.
        colors["bg"] = "#101010"
        missing = []
    if missing:
        return emit({"error": f"theme {slug} is missing {', '.join(missing)}"})

    atomic_write_json(CURRENT, {
        "mode": "tui",
        "md5": "",
        "dir": "",
        "name": slug,
        "theme": slug,
        "extendedDigits": False,
        "colors": colors,
        "size": current_player_size(),
    })
    subprocess.run(["cliamp", "theme", slug], capture_output=True, text=True, timeout=15)
    return emit({"worn": slug, "mode": "tui", "colors": colors})


def cmd_current(args) -> int:
    try:
        return emit(json.loads(CURRENT.read_text()))
    except (OSError, ValueError):
        return emit({"error": "no skin selected yet"})


def cmd_size(args) -> int:
    """Persist a size mode and notify the running player through its state."""
    try:
        state = json.loads(CURRENT.read_text())
    except (OSError, ValueError):
        return emit({"error": "pick a skin before changing player size"})

    state["size"] = args.mode
    atomic_write_json(CURRENT, state)
    return emit({"resized": args.mode, "size": args.mode})


def cmd_apply(args) -> int:
    result = subprocess.run(
        ["cliamp", "theme", args.name], capture_output=True, text=True, timeout=15
    )
    if result.returncode != 0:
        return emit({"error": (result.stderr or result.stdout).strip() or "cliamp theme failed"})
    return emit({"applied": args.name})


def cmd_themes(args) -> int:
    index = read_index()
    result = subprocess.run(
        ["cliamp", "theme", "list"], capture_output=True, text=True, timeout=15
    )
    names = [
        line.strip() for line in result.stdout.splitlines()
        if line.strip() and re.fullmatch(r"[A-Za-z0-9._-]+", line.strip())
    ]
    out = []
    for name in names:
        entry = {"name": name, "converted": name in index}
        path = THEMES / f"{name}.toml"
        if path.exists():
            entry["colors"] = read_theme(path)
        if name in index:
            entry["source"] = index[name].get("source", "")
            entry["md5"] = index[name].get("md5", "")
        out.append(entry)
    return emit({"themes": out})


def read_theme(path: Path) -> dict:
    """Parse a cliamp theme without tomllib, so partial files still render."""
    colors = {}
    for line in path.read_text().splitlines():
        m = re.match(r'\s*(\w+)\s*=\s*"(#?[0-9a-fA-F]{6})"', line)
        if m and m.group(1) in SLOTS:
            colors[m.group(1)] = "#" + m.group(2).lstrip("#").lower()
    return colors


def cmd_save(args) -> int:
    """Write an edited palette, keeping any slot the caller left out."""
    try:
        edits = json.loads(args.json)
    except ValueError as exc:
        return emit({"error": f"bad palette json: {exc}"})

    slug = slugify(args.name)
    path = THEMES / f"{slug}.toml"
    colors = read_theme(path) if path.exists() else {}
    for slot, value in edits.items():
        if slot not in SLOTS:
            continue
        if parse_hex(value) is None:
            return emit({"error": f"{slot}: {value!r} is not a #rrggbb color"})
        colors[slot] = "#" + str(value).lstrip("#").lower()

    missing = [s for s in SLOTS if s not in colors]
    if missing:
        return emit({"error": f"palette is missing {', '.join(missing)}"})

    THEMES.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(f'{s} = "{colors[s]}"' for s in SLOTS) + "\n")

    # A TUI-mode player wearing this theme recolors on the spot.
    try:
        state = json.loads(CURRENT.read_text())
        if state.get("mode") == "tui" and state.get("theme") == slug:
            state["colors"] = colors
            atomic_write_json(CURRENT, state)
    except (OSError, ValueError):
        pass
    subprocess.run(["cliamp", "theme", slug], capture_output=True, text=True, timeout=15)
    return emit({"theme": slug, "colors": colors})


def cmd_remove(args) -> int:
    slug = slugify(args.name)
    path = THEMES / f"{slug}.toml"
    if not path.exists():
        return emit({"error": f"no theme named {slug}"})
    index = read_index()
    if slug not in index:
        # Refuse to delete themes we did not generate; a hand-written theme in
        # the same directory is the user's own work.
        return emit({"error": f"{slug} was not installed by this plugin"})
    path.unlink()
    index.pop(slug, None)
    write_index(index)
    return emit({"removed": slug})


BASE_SKIN_MD5 = "5e4f10275dcb1fb211d4a8b4f1bda236"  # base-2.91, the default


def read_theme_colors() -> dict:
    src = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
    values = {}
    if src.exists():
        for line in src.read_text().splitlines():
            m = re.match(r'\s*([\w.-]+)\s*=\s*"?(#[0-9a-fA-F]{6})"?', line)
            if m:
                values[m.group(1).lower()] = m.group(2).lower()
    return values


def cmd_sync(args) -> int:
    """Dress everything in the current Omarchy theme, as the TUI face.

    Writes the cliamp theme derived from the live colors.toml and wears it
    on the flat TUI face -- the same seven values cliamp reads, so player
    and terminal match exactly. The theme-set hook re-runs this on every
    `omarchy theme set` while it is worn, which is what makes this the one
    look that recolors with the rest of the desktop.

    (cliamp_skinner.theme_skin can still render the palette as a recolored
    bitmap skin, but sync deliberately stopped using it: landing on bitmap
    art from a "sync to theme" button read as a mode switch, not a sync.)
    """
    values = read_theme_colors()
    if not values:
        return emit({"error": "no current Omarchy theme colors found"})

    def pick(*keys, fallback):
        for k in keys:
            if k in values:
                return values[k]
        return fallback

    colors = {
        "bg": pick("background", "bg", fallback="#101315"),
        "fg": pick("muted", "foreground", fallback="#707880"),
        "bright_fg": pick("foreground", "fg", fallback="#cacccc"),
        "accent": pick("accent", "primary", fallback="#cacccc"),
        "green": pick("green", "color2", fallback="#859900"),
        "yellow": pick("yellow", "color3", fallback="#b58900"),
        "red": pick("red", "urgent", "color1", fallback="#dc322f"),
    }
    THEMES.mkdir(parents=True, exist_ok=True)
    (THEMES / "omarchy.toml").write_text(
        "# Synced from the current Omarchy theme\n"
        + "\n".join(f'{s} = "{colors[s]}"' for s in SLOTS)
        + "\n"
    )
    index = read_index()
    index["omarchy"] = {"md5": "", "source": "Omarchy theme"}
    write_index(index)

    atomic_write_json(CURRENT, {
        "mode": "tui",
        "md5": "",
        "dir": "",
        "name": "omarchy",
        "theme": "omarchy",
        "extendedDigits": False,
        "colors": colors,
        "size": current_player_size(),
    })
    subprocess.run(["cliamp", "theme", "omarchy"], capture_output=True, text=True, timeout=15)
    return emit({"worn": "omarchy", "mode": "tui", "theme": "omarchy", "colors": colors})


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("search"); p.add_argument("query")
    p.add_argument("--limit", type=int, default=30); p.add_argument("--offset", type=int, default=0)
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("browse")
    p.add_argument("--limit", type=int, default=30); p.add_argument("--offset", type=int, default=0)
    p.set_defaults(fn=cmd_browse)

    p = sub.add_parser("featured", help="cached top skins (museum ranking)")
    p.add_argument("--limit", type=int, default=30); p.add_argument("--offset", type=int, default=0)
    p.set_defaults(fn=cmd_featured)

    p = sub.add_parser("fetch-featured", help="download the top N skins into the cache")
    p.add_argument("--count", type=int, default=200)
    p.set_defaults(fn=cmd_fetch_featured)

    for name, fn in (("preview", cmd_preview), ("install", cmd_install)):
        p = sub.add_parser(name); p.add_argument("md5"); p.set_defaults(fn=fn)

    p = sub.add_parser("extract", help="unpack sprite sheets for the player")
    p.add_argument("md5"); p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_extract)

    p = sub.add_parser("use", help="wear a skin from an md5 or skins.webamp.org link")
    p.add_argument("md5"); p.add_argument("--no-theme", action="store_true")
    p.set_defaults(fn=cmd_use)

    sub.add_parser("current").set_defaults(fn=cmd_current)

    p = sub.add_parser("size", help="set the player to large or original 1x size")
    p.add_argument("mode", choices=("large", "original"))
    p.set_defaults(fn=cmd_size)

    p = sub.add_parser("use-theme", help="wear a cliamp theme as the flat TUI face")
    p.add_argument("name")
    p.set_defaults(fn=cmd_use_theme)

    p = sub.add_parser("make-theme", help="build a full Omarchy theme from a skin")
    p.add_argument("md5")
    p.set_defaults(fn=cmd_make_theme)

    sub.add_parser("pl", help="playlist window payload").set_defaults(fn=cmd_pl)

    p = sub.add_parser("play-now", help="play a file or stream URL immediately")
    p.add_argument("path"); p.add_argument("--title", default="")
    p.set_defaults(fn=cmd_play_now)

    p = sub.add_parser("play-track", help="play track N of a named playlist")
    p.add_argument("playlist"); p.add_argument("index", type=int)
    p.set_defaults(fn=cmd_play_track)

    p = sub.add_parser("apply"); p.add_argument("name"); p.set_defaults(fn=cmd_apply)
    p = sub.add_parser("remove"); p.add_argument("name"); p.set_defaults(fn=cmd_remove)
    p = sub.add_parser("save"); p.add_argument("name"); p.add_argument("json")
    p.set_defaults(fn=cmd_save)
    sub.add_parser("themes").set_defaults(fn=cmd_themes)
    sub.add_parser("sync").set_defaults(fn=cmd_sync)

    args = ap.parse_args()
    try:
        return args.fn(args)
    except Exception as exc:  # one error shape for the QML side
        return emit({"error": f"{type(exc).__name__}: {exc}"})


if __name__ == "__main__":
    raise SystemExit(main())
