#!/bin/bash
# OmaAmp — the Winamp window, as its own application.
#
# Runs as a separate Quickshell process rather than inside omarchy-shell on
# purpose: it decodes bitmaps from arbitrary archives in a 102,000-skin corpus,
# and a decoder fault here closes a music player instead of taking down the
# bar, notifications and lock screen.
#
#   omaamp                  launch (or focus, if already running)
#   omaamp --skin <md5>     launch wearing a specific museum skin
#   omaamp --zoom 3         integer pixel scale (default 2)
#   omaamp --quit
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SKINNER="$ROOT/bin/skinner"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omaamp"
mkdir -p "$STATE"

ZOOM="${OMAAMP_ZOOM:-2}"
SKIN_MD5=""

while (($#)); do
  case "$1" in
    --skin) SKIN_MD5="${2:-}"; shift 2 ;;
    --zoom) ZOOM="${2:-2}"; shift 2 ;;
    --quit)
      pkill -f "quickshell -p $ROOT/player" && echo "OmaAmp closed" || echo "OmaAmp was not running"
      exit 0 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "omaamp: unknown option $1" >&2; exit 2 ;;
  esac
done

# The skin lives in ~/.local/state/omaamp/current.json, written by
# `skinner use` and watched by the running player. --skin just routes
# through the same path, so launch and live-swap behave identically.
if [[ -n $SKIN_MD5 ]]; then
  "$SKINNER" use "$SKIN_MD5" >/dev/null || true
fi

if [[ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/omaamp/current.json" ]]; then
  echo "omaamp: no skin selected yet — pick one from the Winamp Skins bar widget," >&2
  echo "        or run: omaamp --skin <md5>" >&2
  exit 1
fi

export OMAAMP_ZOOM="$ZOOM"

# Quickshell's appId is read-only, so every instance is class org.quickshell.
# The window title is ours, though, which is what the Hyprland rules match on
# and what lets us focus an existing instance instead of spawning a second.
if command -v hyprctl >/dev/null && hyprctl clients -j 2>/dev/null | grep -q '"title": "OmaAmp'; then
  hyprctl dispatch focuswindow "title:^OmaAmp.*$" >/dev/null
  exit 0
fi

exec quickshell -p "$ROOT/player"
