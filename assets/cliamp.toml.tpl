# cliamp theme rendered from the active Omarchy theme.
# Installed by OmaAmp as ~/.config/omarchy/themed/cliamp.toml.tpl; Omarchy
# re-renders it on every theme switch, and a theme-set hook re-applies it.
#
# Mapping notes: cliamp's `bright_fg` is its primary text and `fg` its muted
# text, so they take Omarchy's foreground/muted rather than the brighter pair.
bg = "{{ background }}"
accent = "{{ accent }}"
bright_fg = "{{ foreground }}"
fg = "{{ muted }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
red = "{{ red }}"
